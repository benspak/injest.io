    "dotenv": "^16.3.1",
    "fastify": "^4.25.2",
    "pg": "^8.11.3",
    "postgres": "^3.4.3",
    "zod": "^3.22.4",
    "ioredis": "^5.3.2",
    "bullmq": "^5.4.3",

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/injest
PGVECTOR_ENABLED=true

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# OpenAI
OPENAI_API_KEY=your-openai-api-key
# Optional: Set to 'small' to use text-embedding-3-small (10x cheaper, requires DB migration to 1536 dims)
# OPENAI_EMBEDDING_MODEL=small

# Resend
RESEND_API_KEY=your-resend-api-key
RECEIVING_EMAIL=input@injest.io

# Application
PORT=5555
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:5555

# File Storage
UPLOAD_DIR=./uploads

# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key

# X.com (Twitter) API
# OAuth 2.0 PKCE credentials (required for per-user OAuth)
X_CLIENT_ID=your-x-client-id
X_CLIENT_SECRET=your-x-client-secret
# Callback URL for posting OAuth (connect account for posting)
X_CALLBACK_URL=https://yourdomain.com/api/xcom/callback
# For local development: X_CALLBACK_URL=http://localhost:5555/api/xcom/callback
# Callback URL for login OAuth (sign in with X.com)
X_LOGIN_CALLBACK_URL=https://yourdomain.com/api/auth/xcom/callback
# For local development: X_LOGIN_CALLBACK_URL=http://localhost:5555/api/auth/xcom/callback
# NOTE: Both callback URLs must be registered in your X.com Developer Portal app settings

# OAuth 2.0 Bearer Token (optional fallback for app-level posting)
X_BEARER_TOKEN=your-x-bearer-token
# OAuth 1.0a credentials (optional fallback for media upload)
X_API_KEY=your-x-api-key
X_API_SECRET=your-x-api-secret
X_ACCESS_TOKEN=your-x-access-token
X_ACCESS_TOKEN_SECRET=your-x-access-token-secret

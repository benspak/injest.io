# Database
DATABASE_URL=postgresql://user:password@localhost:5432/injest
PGVECTOR_ENABLED=true

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# OpenAI
OPENAI_API_KEY=your-openai-api-key
# Optional: Set to 'small' to use text-embedding-3-small (10x cheaper, requires DB migration to 1536 dims)
# OPENAI_EMBEDDING_MODEL=small

# Resend
RESEND_API_KEY=your-resend-api-key
RECEIVING_EMAIL=input@injest.io

# Application
PORT=5555
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:5555

# File Storage
UPLOAD_DIR=./uploads

# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
